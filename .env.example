# =============================================================================
# polysignal-intelligence – Beispielkonfiguration
# Kopieren nach `.env` (im Repository-Root) und Werte setzen.
# Diese Datei enthaelt KEINE echten Secrets.
# =============================================================================

# --- Applikation --------------------------------------------------------------
APP_ENVIRONMENT=local                # local | staging | production
APP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
APP_KILL_SWITCH=false                # true = Bot pausiert (keine neuen Signale)
APP_CONFIG_VERSION=v1
APP_STRATEGY_VERSION=v1
APP_DISPLAY_TIMEZONE=Europe/Berlin   # Anzeige-Zeitzone fuer Telegram; Speicherung immer UTC

# --- API (FastAPI) ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---------------------------------------------------------------
# Wird von der App verwendet. Innerhalb von Docker Compose zeigt der Host auf
# den Service `polysignal_postgres`, lokal auf `localhost`.
DATABASE_URL=postgresql+asyncpg://polysignal_user:change-me@localhost:5432/polysignal_intelligence
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Nur fuer Docker Compose (Initialisierung des Postgres-Containers):
POSTGRES_PASSWORD=change-me

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=polysignal:

# --- Polymarket Perps (nur oeffentliche Marktdaten, read-only) ----------------
POLYMARKET_REST_BASE_URL=https://api.perpetuals.polymarket.com
POLYMARKET_REQUEST_TIMEOUT_SECONDS=10
POLYMARKET_MAX_RETRIES=3
POLYMARKET_BACKOFF_BASE_SECONDS=0.5
POLYMARKET_BACKOFF_MAX_SECONDS=30
# Gewichtetes Token-Budget pro Minute (Polymarket-Limit: 1000/min pro IP;
# konservativ darunter bleiben):
POLYMARKET_RATE_LIMIT_BUDGET_PER_MINUTE=800
POLYMARKET_INSTRUMENT_CACHE_TTL_SECONDS=300
POLYMARKET_KLINES_CACHE_TTL_SECONDS=60

# --- Polymarket Perps WebSocket (oeffentlicher Marktdaten-Stream) --------------
POLYMARKET_PERPS_WS_URL=wss://ws.perpetuals.polymarket.com/v1/ws
POLYMARKET_WS_ENABLED=true
POLYMARKET_WS_CONNECT_TIMEOUT_SECONDS=10
# Heartbeat: Ping-Intervall und Timeout (Verbindungsabbruch -> Reconnect)
POLYMARKET_WS_PING_INTERVAL_SECONDS=20
POLYMARKET_WS_PING_TIMEOUT_SECONDS=10
# Reconnect: Exponential Backoff zwischen Min und Max, plus Jitter
POLYMARKET_WS_RECONNECT_MIN_SECONDS=1
POLYMARKET_WS_RECONNECT_MAX_SECONDS=60
POLYMARKET_WS_RECONNECT_JITTER_SECONDS=2
# Mehr Fehlversuche als dieses Limit im Fenster -> Status DEGRADED (weiter
# langsame Retries mit Max-Backoff, kein Aufgeben, keine Busy-Loops)
POLYMARKET_WS_MAX_RECONNECT_ATTEMPTS=10
POLYMARKET_WS_RECONNECT_WINDOW_SECONDS=300
# API-Limit: max. 100 Subscriptions pro Verbindung
POLYMARKET_WS_MAX_SUBSCRIPTIONS=100
POLYMARKET_WS_EVENT_QUEUE_SIZE=10000
POLYMARKET_WS_ORDERBOOK_DEPTH=100
# Persistenz-Batching (Buffer -> DB): Batchgroesse und Flush-Intervall
POLYMARKET_WS_PERSIST_BATCH_SIZE=200
POLYMARKET_WS_PERSIST_FLUSH_SECONDS=5
POLYMARKET_WS_KLINE_TIMEFRAMES=1m,5m,15m,1h

# --- Datenfrische pro Channel (Sekunden; siehe docs/architecture.md) ----------
# Alter <= 50% der Schwelle: FRESH · <= Schwelle: AGING · > Schwelle: STALE
DATA_FRESHNESS_TICKER_SECONDS=15
DATA_FRESHNESS_BBO_SECONDS=10
DATA_FRESHNESS_ORDERBOOK_SECONDS=15
DATA_FRESHNESS_TRADES_SECONDS=300
DATA_FRESHNESS_CANDLES_SECONDS=180

# --- Telegram (einziger externer Output-Kanal) --------------------------------
# Sicherer Default: deaktiviert. Erst aktivieren, wenn Token + Gruppen-ID gesetzt
# sind (BotFather-Anleitung: docs/operations.md).
TELEGRAM_ENABLED=false
# Bot-Token vom BotFather (SecretStr, taucht nie in Logs/Repr auf):
TELEGRAM_BOT_TOKEN=
# Ziel-Gruppe (Integer, bei Supergruppen negativ, z. B. -1001234567890):
TELEGRAM_GROUP_ID=
# Nur diese User-IDs duerfen Admin-Kommandos verwenden (Komma-separiert oder JSON):
TELEGRAM_ADMIN_USER_IDS=
# Formatierung (nur HTML unterstuetzt; Escaping wird zentral behandelt):
TELEGRAM_PARSE_MODE=HTML
# Admin-Kommandos per Long Polling (kein Webhook in V1):
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
# Persistente Delivery-Queue: Kapazitaet offener Deliveries, Batch, Idle-Takt
TELEGRAM_DELIVERY_QUEUE_SIZE=500
TELEGRAM_DELIVERY_BATCH_SIZE=10
TELEGRAM_DELIVERY_FLUSH_SECONDS=1
# Lease fuer PROCESSING-Deliveries (abgelaufene Leases werden zurueckgewonnen):
TELEGRAM_DELIVERY_LEASE_SECONDS=60
# Retries: begrenzte Versuche, Exponential Backoff + Jitter, 429 Retry-After
TELEGRAM_MAX_RETRY_ATTEMPTS=5
TELEGRAM_RETRY_MIN_SECONDS=1
TELEGRAM_RETRY_MAX_SECONDS=60
TELEGRAM_RETRY_JITTER_SECONDS=1
# Rate Limits pro Gruppe (konservativ unter Telegram-Limit ~20/min):
TELEGRAM_GROUP_MESSAGES_PER_MINUTE=18
TELEGRAM_GROUP_MIN_INTERVAL_SECONDS=1.5
TELEGRAM_EDIT_MIN_INTERVAL_SECONDS=3
# Identischer Inhalt innerhalb dieses Fensters wird als Duplikat verworfen:
TELEGRAM_DEDUPLICATION_WINDOW_SECONDS=300
TELEGRAM_SYSTEM_ALERTS_ENABLED=true
# Cooldown pro Admin fuer /status, /health und /daily:
TELEGRAM_STATUS_COMMAND_COOLDOWN_SECONDS=15
TELEGRAM_ADMIN_COMMAND_AUDIT_ENABLED=true

# --- Marktuniversum (V1) ------------------------------------------------------
# Symbole, keine Instrument-IDs. IDs werden dynamisch per Discovery aufgeloest.
UNIVERSE_EQUITY_SYMBOLS=AAPL-PERP
UNIVERSE_CRYPTO_SYMBOLS=BTC-PERP
UNIVERSE_REFRESH_ENABLED=true
UNIVERSE_REFRESH_INTERVAL_SECONDS=300
UNIVERSE_REFRESH_JITTER_SECONDS=15

# --- Datenqualitaet -----------------------------------------------------------
# So viele invalide Events pro Instrument im Fenster => DATA_INVALID
DATA_QUALITY_INVALID_EVENT_THRESHOLD=20
DATA_QUALITY_INVALID_EVENT_WINDOW_SECONDS=60
# Max. plausible Abweichung eines Preises vom letzten Mark Price (Basispunkte)
DATA_OUTLIER_MAX_DEVIATION_BPS=500
# Mark-/Index-/Mid-Divergenz oberhalb dieser Schwelle => DEGRADED
DATA_QUALITY_MARK_DIVERGENCE_DEGRADED_BPS=300

# --- Marktselektion (Phase 7) --------------------------------------------------
# Reiner Daten-/Liquiditaets-/Handelbarkeits-Filter - keine Handelsstrategie.
MARKET_SELECTION_ENABLED=true
MARKET_SELECTION_REFRESH_SECONDS=30
# Mindest-Market-Quality-Score (0-100) fuer aktive Watchlist:
MARKET_SELECTION_MIN_QUALITY_SCORE=70
MARKET_SELECTION_MAX_WATCHLIST_SIZE=5
# Zulaessige Asset-Klassen (EQUITY, INDEX, CRYPTO, COMMODITY, FX, UNKNOWN):
MARKET_SELECTION_ALLOWED_ASSET_CLASSES=EQUITY,CRYPTO
# Nur diese Symbole koennen aktiv werden (leer = alle entdeckten); muss im
# Discovery-Universum liegen und umgeht keine Policy-/Datenqualitaetsblockade:
MARKET_SELECTION_DEFAULT_ALLOWLIST=AAPL-PERP,BTC-PERP
# Denylist hat immer Vorrang (Symbole, Komma-separiert):
MARKET_SELECTION_DENYLIST=
# Konservativ: 24h-Volumen und frisches Orderbuch sind Pflicht, DEGRADED-Daten
# sind nicht zulaessig:
MARKET_SELECTION_REQUIRE_VOLUME=true
MARKET_SELECTION_REQUIRE_FRESH_ORDERBOOK=true
MARKET_SELECTION_ALLOW_DEGRADED_DATA=false
# Optionale technische Telegram-Meldungen (Default aus; nie Handelsrichtung):
MARKET_SELECTION_NOTIFY_STATE_CHANGES=false
MARKET_SELECTION_NOTIFY_SESSION_CHANGES=false
# Symbol-Overrides (JSON), z. B. {"AAPL-PERP": {"max_spread_bps": 30}}:
MARKET_SELECTION_SYMBOL_OVERRIDES_JSON={}
# Asset-Class-Policies (JSON), z. B. {"INDEX": {"enabled": true}}:
MARKET_SELECTION_ASSET_CLASS_POLICIES_JSON={}

# --- Equity-Sessions & Kalender (America/New_York; Speicherung immer UTC) ------
EQUITY_CALENDAR_ENABLED=true
# Muss zur mitgelieferten Kalenderdatei passen; Abweichung => CALENDAR_UNAVAILABLE:
EQUITY_CALENDAR_VERSION=us-equity-2026.1
EQUITY_CALENDAR_MIN_YEAR=2026
EQUITY_CALENDAR_MAX_YEAR=2028
EQUITY_REGULAR_SESSION_OPEN=09:30
EQUITY_REGULAR_SESSION_CLOSE=16:00
EQUITY_EARLY_CLOSE_DEFAULT=13:00
EQUITY_PREMARKET_ENABLED=true
EQUITY_AFTER_HOURS_ENABLED=true
# V1: keine aktive Analyse in Pre-Market/After-Hours:
EQUITY_PREMARKET_ANALYSIS_ENABLED=false
EQUITY_AFTER_HOURS_ANALYSIS_ENABLED=false

# --- Crypto-Sessions ------------------------------------------------------------
CRYPTO_SESSION_ENABLED=true
# Optionale UTC-Fenster mit duenner Liquiditaet, z. B.
# [{"days": [5, 6], "start": "22:00", "end": "04:00"}] (0=Mo .. 6=So):
CRYPTO_THIN_LIQUIDITY_WINDOWS_JSON=[]
# LIMITED_SESSION = strengere Qualitaetsanforderungen im Fenster; IGNORE = aus:
CRYPTO_THIN_LIQUIDITY_POLICY=LIMITED_SESSION

# --- Marktqualitaets-Schwellen je Asset-Klasse ----------------------------------
EQUITY_MAX_SPREAD_BPS=20
CRYPTO_MAX_SPREAD_BPS=10
EQUITY_MIN_BOOK_DEPTH_PUSD=5000
CRYPTO_MIN_BOOK_DEPTH_PUSD=10000
EQUITY_MIN_VOLUME_24H_PUSD=100000
CRYPTO_MIN_VOLUME_24H_PUSD=500000
EQUITY_MAX_MARK_INDEX_MID_DEVIATION_BPS=75
CRYPTO_MAX_MARK_INDEX_MID_DEVIATION_BPS=50

# --- Strategie-Research-Foundation (Phase 8) -----------------------------------
# Erzeugt ausschliesslich interne Research-SetupCandidates - KEINE Trade-Signale,
# keine Telegram-Ausgabe, keine Entry-/Stop-/Hebel-/Kostenberechnung.
STRATEGY_ENABLED=true
STRATEGY_NAME=market_structure_v1
STRATEGY_VERSION=1.0.0
STRATEGY_EVALUATION_REFRESH_SECONDS=20
STRATEGY_MAX_CONCURRENT_EVALUATIONS=4
STRATEGY_REQUIRE_ACTIVE_WATCHLIST=true
STRATEGY_REQUIRE_HEALTHY_DATA=true
STRATEGY_ALLOW_DEGRADED_DATA=false
STRATEGY_REQUIRE_FRESH_ORDERBOOK=true
# Research-Qualitaetsscore-Schwelle (0-100) fuer Kandidaten:
STRATEGY_MIN_SETUP_SCORE=75
STRATEGY_CANDIDATE_DEDUPE_SECONDS=1800
STRATEGY_REJECTION_PERSIST_SECONDS=300
STRATEGY_MAX_ACTIVE_CANDIDATES_PER_INSTRUMENT=2
# Technischer Evaluierungsablauf: N abgeschlossene 5m-Candles ohne Bestaetigung:
STRATEGY_EXPIRE_AFTER_5M_CANDLES=6
STRATEGY_PERSIST_FEATURE_SNAPSHOTS=true
STRATEGY_FEATURE_RETENTION_DAYS=14

# Pflicht-Timeframes (5m, 15m, 1h zwingend; 1m optional):
STRATEGY_REQUIRED_TIMEFRAMES=5m,15m,1h
STRATEGY_MIN_CANDLES_1M=60
STRATEGY_MIN_CANDLES_5M=60
STRATEGY_MIN_CANDLES_15M=40
STRATEGY_MIN_CANDLES_1H=30
STRATEGY_MAX_CANDLE_GAP_MULTIPLIER=1.5
STRATEGY_ALLOW_1M_OPTIONAL=true

# Swing-/Struktur-/Liquidity-Parameter:
STRATEGY_SWING_LEFT_BARS=2
STRATEGY_SWING_RIGHT_BARS=2
STRATEGY_SWING_ATR_MULTIPLIER=0.5
STRATEGY_EQUAL_LEVEL_TOLERANCE_BPS=5
STRATEGY_STRUCTURE_BREAK_CONFIRMATION_CLOSES=1
STRATEGY_LIQUIDITY_LEVEL_LOOKBACK=50
STRATEGY_SWEEP_MIN_OVERSHOOT_BPS=3
STRATEGY_RECLAIM_TOLERANCE_BPS=2
STRATEGY_RETEST_TOLERANCE_BPS=10
STRATEGY_RETEST_MAX_5M_CANDLES=12

# Volatilitaet / Momentum / Volumen:
STRATEGY_ATR_PERIOD=14
STRATEGY_VOLATILITY_LOOKBACK=100
STRATEGY_HIGH_VOLATILITY_PERCENTILE=90
STRATEGY_MOMENTUM_LOOKBACK=10
STRATEGY_VOLUME_LOOKBACK=20
STRATEGY_MIN_RELATIVE_VOLUME=1.2
STRATEGY_REQUIRE_VOLUME_CONFIRMATION=false
STRATEGY_REQUIRE_MOMENTUM_CONFIRMATION=true

# Score-Gewichte (JSON, Summe exakt 100) und Regime-Regeln:
STRATEGY_SCORE_WEIGHTS_JSON={"htf_bias":20,"structure_15m":20,"liquidity_event":15,"local_confirmation_5m":15,"momentum":10,"volume":10,"market_context":5,"volatility_fit":5}
STRATEGY_REGIME_RULES_JSON={"trend_efficiency_ratio_min":0.35,"range_efficiency_ratio_max":0.2,"breakout_lookback":20,"trend_lookback":30,"low_liquidity_quality_below":60}
STRATEGY_SYMBOL_OVERRIDES_JSON={}
# Event-Risk-Fenster (manuell/kalenderbasiert, Default aus; keine News-Scraper):
STRATEGY_EVENT_RISK_ENABLED=false
STRATEGY_EVENT_RISK_WINDOWS_JSON=[]

# --- Risk Engine (Phase 9) ------------------------------------------------
# Interne Research-Eignungsbewertung - KEINE Trade-Signale, keine echten
# Konto-/Positionsdaten. Alle Betraege sind hypothetische Referenzwerte.
RISK_ENGINE_ENABLED=true
RISK_MODEL_NAME=conservative_eligibility_v1
RISK_MODEL_VERSION=1.0.0
RISK_PLAN_EVALUATION_REFRESH_SECONDS=20
RISK_MAX_CONCURRENT_EVALUATIONS=4
RISK_REQUIRE_CONFIRMED_CANDIDATE=true
RISK_REQUIRE_HEALTHY_DATA=true
RISK_ALLOW_DEGRADED_DATA=false
RISK_REQUIRE_FRESH_ORDERBOOK=true
RISK_PLAN_DEDUPE_SECONDS=900
RISK_MAX_ACTIVE_PLANS_PER_INSTRUMENT=2
RISK_PLAN_EXPIRY_SECONDS=1800
RISK_ELIGIBILITY_MIN_SCORE=75
# Virtuelles Referenzkonto (pUSD) - niemals eine echte Kontogroesse
RISK_VIRTUAL_REFERENCE_ACCOUNT_PUSD=10000
# Prozentpunkte (0.5 = 0.5 %)
RISK_REFERENCE_RISK_PER_PLAN_PCT=0.5
RISK_MIN_DISTANCE_BPS=15
RISK_MAX_DISTANCE_BPS=400
RISK_MIN_DISTANCE_ATR_MULTIPLE=0.5
RISK_MAX_DISTANCE_ATR_MULTIPLE=4.0
RISK_INVALIDATION_BUFFER_BPS=5
RISK_INVALIDATION_BUFFER_ATR_MULTIPLE=0.25
RISK_TARGET_MIN_RELEVANCE_SCORE=0.3
RISK_MAX_ENTRY_CHASE_BPS=20
RISK_MAX_REFERENCE_NOTIONAL_PUSD=50000
# Harter V1-Deckel: maximal 3x, auch wenn das Instrument mehr erlaubt
RISK_MAX_REFERENCE_LEVERAGE=3.0
RISK_MIN_NET_RR=1.8
# Prozentpunkte des technischen Risikos
RISK_MAX_COST_TO_RISK_PCT=15
# Margin/Liquidation: ohne oeffentliche Margin-Daten wird blockiert;
# das approximierte Modell ist nur per explizitem Opt-in aktiv
RISK_REQUIRE_INSTRUMENT_MARGIN_DATA=true
RISK_ALLOW_APPROXIMATED_MARGIN_MODEL=false
# Dezimalbrueche (0.34 = 34 %), nur fuer das Opt-in-Approximationsmodell
RISK_APPROX_INITIAL_MARGIN_RATE=0.34
RISK_APPROX_MAINTENANCE_MARGIN_RATE=0.1
RISK_MIN_LIQUIDATION_BUFFER_BPS=150
RISK_MIN_LIQUIDATION_BUFFER_ATR_MULTIPLE=1.0
RISK_MARGIN_STRESS_BUFFER_BPS=50
RISK_ISOLATED_MARGIN_ONLY=true
# Gewichte muessen exakt 100 ergeben
RISK_ELIGIBILITY_SCORE_WEIGHTS_JSON={"invalidation_quality":20,"target_quality":15,"net_rr":25,"executability":15,"cost_quality":10,"margin_buffer":10,"data_confidence":5}
RISK_SYMBOL_OVERRIDES_JSON={}
RISK_ASSET_CLASS_OVERRIDES_JSON={}

# --- Cost Engine (Phase 9) ------------------------------------------------
# Konservatives Kostenmodell (Annahmen!). Fee-Saetze sind Dezimalbrueche
# (0.0007 = 0.07 %) und muessen vor Live-Betrieb gegen die offizielle
# Polymarket-Dokumentation validiert werden.
COST_ENGINE_ENABLED=true
COST_MODEL_NAME=conservative_costs_v1
COST_MODEL_VERSION=1.0.0
COST_FEE_SCHEDULE_SOURCE=local_config_assumption
COST_FEE_SCHEDULE_VERSION=polymarket-perps-assumed-1
COST_ASSUMED_FEE_TIER=default
COST_DEFAULT_MAKER_FEE_RATE=0.0002
COST_DEFAULT_TAKER_FEE_RATE=0.0007
COST_REQUIRE_ACTIVE_FEE_SCHEDULE=true
COST_EXECUTION_ASSUMPTION_VERSION=taker-conservative-1
COST_ENTRY_EXECUTION_MODE=ENTRY_TAKER
COST_TARGET_EXECUTION_MODE=TARGET_TAKER
COST_INVALIDATION_EXECUTION_MODE=STOP_STRESS_TAKER
COST_SLIPPAGE_ENABLED=true
COST_REQUIRE_FRESH_ORDERBOOK=true
COST_ORDERBOOK_MAX_LEVELS=25
COST_ORDERBOOK_MAX_DISTANCE_BPS=50
COST_ENTRY_SLIPPAGE_STRESS_BPS=2
COST_TARGET_SLIPPAGE_STRESS_BPS=2
COST_INVALIDATION_SLIPPAGE_STRESS_BPS=8
COST_MAX_SLIPPAGE_TO_RISK_PCT=8
COST_FUNDING_ENABLED=true
COST_REQUIRE_FUNDING_DATA=true
COST_FUNDING_LOOKBACK_HOURS=72
COST_FUNDING_CONSERVATIVE_PERCENTILE=75
# Technische, konservative Halteannahme in Minuten - keine Prognose
COST_REFERENCE_HOLD_MINUTES=240
COST_EQUITY_OVERNIGHT_BLOCKED=true
COST_FUNDING_BUFFER_BPS=1
COST_CONSERVATIVE_COST_BUFFER_BPS=1

# --- Internal Signal Lifecycle (Phase 10) ---------------------------------
# Interner Research-Lifecycle: Zustaende beschreiben die technische
# Entwicklung eines Signals - nie eine reale Position, nie ein Trade.
SIGNAL_LIFECYCLE_ENABLED=true
SIGNAL_LIFECYCLE_MODEL_NAME=internal_research_lifecycle_v1
SIGNAL_LIFECYCLE_MODEL_VERSION=1.0.0
SIGNAL_LIFECYCLE_MONITOR_REFRESH_SECONDS=10
SIGNAL_LIFECYCLE_MAX_CONCURRENT_MONITORS=4
SIGNAL_LIFECYCLE_MAX_ACTIVE_PER_INSTRUMENT=2
SIGNAL_LIFECYCLE_DEDUPE_SECONDS=900
SIGNAL_LIFECYCLE_PLAN_MAX_AGE_SECONDS=1800
SIGNAL_LIFECYCLE_CANDIDATE_MAX_AGE_SECONDS=3600
SIGNAL_LIFECYCLE_SNAPSHOT_MAX_AGE_SECONDS=900
SIGNAL_LIFECYCLE_ENTRY_MAX_WAIT_SECONDS=1800
SIGNAL_LIFECYCLE_ACTIVE_MAX_DURATION_SECONDS=21600
SIGNAL_LIFECYCLE_DATA_DEGRADED_GRACE_SECONDS=120
SIGNAL_LIFECYCLE_QUEUE_SIZE=256
SIGNAL_LIFECYCLE_LEASE_SECONDS=60
SIGNAL_LIFECYCLE_EVENT_SCHEMA_VERSION=sev-1
SIGNAL_LIFECYCLE_UPDATE_SCHEMA_VERSION=suv-1
SIGNAL_LIFECYCLE_REJECTION_PERSIST_SECONDS=300
# Admission-Gates: jede Bedingung blockiert konservativ
SIGNAL_LIFECYCLE_REQUIRE_ELIGIBLE_PLAN=true
SIGNAL_LIFECYCLE_REQUIRE_CONFIRMED_CANDIDATE=true
SIGNAL_LIFECYCLE_REQUIRE_ACTIVE_WATCHLIST=true
SIGNAL_LIFECYCLE_REQUIRE_ALLOWED_SESSION=true
SIGNAL_LIFECYCLE_REQUIRE_HEALTHY_DATA=true
SIGNAL_LIFECYCLE_ALLOW_DEGRADED_DATA=false
SIGNAL_LIFECYCLE_REQUIRE_FRESH_ORDERBOOK=true
SIGNAL_LIFECYCLE_MIN_MARKET_QUALITY_SCORE=70
# Trigger-Politik: Bestaetigungen nur ueber Mark/BBO/GESCHLOSSENE 5m-Kerzen
SIGNAL_ENTRY_TRIGGER_DEFAULT=ZONE_TOUCH_AND_5M_CLOSE_CONFIRM
SIGNAL_INVALIDATION_TRIGGER_POLICY=CONSERVATIVE_COMBINED
SIGNAL_TARGET_TRIGGER_POLICY=FIVE_M_CLOSE_AT_OR_BEYOND_TARGET
SIGNAL_ENTRY_ZONE_TOLERANCE_BPS=5
SIGNAL_ENTRY_CONFIRMATION_TIMEFRAME=5m
SIGNAL_ENTRY_CLOSE_CONFIRMATION_REQUIRED=true
SIGNAL_INVALIDATION_CLOSE_CONFIRMATION_REQUIRED=false
SIGNAL_TARGET_CLOSE_CONFIRMATION_REQUIRED=true
SIGNAL_MONITOR_USE_MARK_PRICE=true
SIGNAL_MONITOR_USE_BBO=true
SIGNAL_MONITOR_STRUCTURE_EXIT_ENABLED=true
SIGNAL_MONITOR_TARGETS_ENABLED=true
SIGNAL_MONITOR_SESSION_END_POLICY=EXPIRE
SIGNAL_MONITOR_POST_ENTRY_EXPIRY_POLICY=EXPIRE
SIGNAL_MONITOR_SUPERSEDE_POLICY=STRICT
# Strikt distinkte Prioritaeten; DATA_INVALID muss am hoechsten stehen
SIGNAL_MONITOR_EVENT_PRIORITY_JSON={"DATA_INVALID":100,"INVALIDATED":90,"SUPERSEDED":80,"EXPIRED":70,"PAUSED":65,"TECHNICAL_EXIT":60,"TARGET_2_REACHED":50,"TARGET_1_REACHED":40,"ENTRY_CONFIRMED":30,"INFO":10}
SIGNAL_LIFECYCLE_PERSIST_UPDATES=true
SIGNAL_LIFECYCLE_NOTIFY_ENABLED=false
# HARTE REGEL Phase 10: kein Telegram-Output aus dem Lifecycle.
# true wird von der Konfigurationsvalidierung abgelehnt (Startabbruch).
SIGNAL_LIFECYCLE_TELEGRAM_OUTPUT_ENABLED=false
