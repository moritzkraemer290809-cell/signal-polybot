# =============================================================================
# polysignal-intelligence – Beispielkonfiguration
# Kopieren nach `.env` (im Repository-Root) und Werte setzen.
# Diese Datei enthaelt KEINE echten Secrets.
# =============================================================================

# --- Applikation --------------------------------------------------------------
APP_ENVIRONMENT=local                # local | staging | production
APP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
APP_KILL_SWITCH=false                # true = Bot pausiert (keine neuen Signale)
APP_CONFIG_VERSION=v1
APP_STRATEGY_VERSION=v1
APP_DISPLAY_TIMEZONE=Europe/Berlin   # Anzeige-Zeitzone fuer Telegram; Speicherung immer UTC

# --- API (FastAPI) ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---------------------------------------------------------------
# Wird von der App verwendet. Innerhalb von Docker Compose zeigt der Host auf
# den Service `polysignal_postgres`, lokal auf `localhost`.
DATABASE_URL=postgresql+asyncpg://polysignal_user:change-me@localhost:5432/polysignal_intelligence
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Nur fuer Docker Compose (Initialisierung des Postgres-Containers):
POSTGRES_PASSWORD=change-me

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=polysignal:

# --- Polymarket Perps (nur oeffentliche Marktdaten, read-only) ----------------
POLYMARKET_REST_BASE_URL=https://api.perpetuals.polymarket.com
POLYMARKET_REQUEST_TIMEOUT_SECONDS=10
POLYMARKET_MAX_RETRIES=3
POLYMARKET_BACKOFF_BASE_SECONDS=0.5
POLYMARKET_BACKOFF_MAX_SECONDS=30
# Gewichtetes Token-Budget pro Minute (Polymarket-Limit: 1000/min pro IP;
# konservativ darunter bleiben):
POLYMARKET_RATE_LIMIT_BUDGET_PER_MINUTE=800
POLYMARKET_INSTRUMENT_CACHE_TTL_SECONDS=300
POLYMARKET_KLINES_CACHE_TTL_SECONDS=60

# --- Polymarket Perps WebSocket (oeffentlicher Marktdaten-Stream) --------------
POLYMARKET_PERPS_WS_URL=wss://ws.perpetuals.polymarket.com/v1/ws
POLYMARKET_WS_ENABLED=true
POLYMARKET_WS_CONNECT_TIMEOUT_SECONDS=10
# Heartbeat: Ping-Intervall und Timeout (Verbindungsabbruch -> Reconnect)
POLYMARKET_WS_PING_INTERVAL_SECONDS=20
POLYMARKET_WS_PING_TIMEOUT_SECONDS=10
# Reconnect: Exponential Backoff zwischen Min und Max, plus Jitter
POLYMARKET_WS_RECONNECT_MIN_SECONDS=1
POLYMARKET_WS_RECONNECT_MAX_SECONDS=60
POLYMARKET_WS_RECONNECT_JITTER_SECONDS=2
# Mehr Fehlversuche als dieses Limit im Fenster -> Status DEGRADED (weiter
# langsame Retries mit Max-Backoff, kein Aufgeben, keine Busy-Loops)
POLYMARKET_WS_MAX_RECONNECT_ATTEMPTS=10
POLYMARKET_WS_RECONNECT_WINDOW_SECONDS=300
# API-Limit: max. 100 Subscriptions pro Verbindung
POLYMARKET_WS_MAX_SUBSCRIPTIONS=100
POLYMARKET_WS_EVENT_QUEUE_SIZE=10000
POLYMARKET_WS_ORDERBOOK_DEPTH=100
# Persistenz-Batching (Buffer -> DB): Batchgroesse und Flush-Intervall
POLYMARKET_WS_PERSIST_BATCH_SIZE=200
POLYMARKET_WS_PERSIST_FLUSH_SECONDS=5
POLYMARKET_WS_KLINE_TIMEFRAMES=1m,5m,15m,1h

# --- Datenfrische pro Channel (Sekunden; siehe docs/architecture.md) ----------
# Alter <= 50% der Schwelle: FRESH · <= Schwelle: AGING · > Schwelle: STALE
DATA_FRESHNESS_TICKER_SECONDS=15
DATA_FRESHNESS_BBO_SECONDS=10
DATA_FRESHNESS_ORDERBOOK_SECONDS=15
DATA_FRESHNESS_TRADES_SECONDS=300
DATA_FRESHNESS_CANDLES_SECONDS=180

# --- Telegram (einziger externer Output-Kanal) --------------------------------
# Sicherer Default: deaktiviert. Erst aktivieren, wenn Token + Gruppen-ID gesetzt
# sind (BotFather-Anleitung: docs/operations.md).
TELEGRAM_ENABLED=false
# Bot-Token vom BotFather (SecretStr, taucht nie in Logs/Repr auf):
TELEGRAM_BOT_TOKEN=
# Ziel-Gruppe (Integer, bei Supergruppen negativ, z. B. -1001234567890):
TELEGRAM_GROUP_ID=
# Nur diese User-IDs duerfen Admin-Kommandos verwenden (Komma-separiert oder JSON):
TELEGRAM_ADMIN_USER_IDS=
# Formatierung (nur HTML unterstuetzt; Escaping wird zentral behandelt):
TELEGRAM_PARSE_MODE=HTML
# Admin-Kommandos per Long Polling (kein Webhook in V1):
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_POLLING_TIMEOUT_SECONDS=25
# Persistente Delivery-Queue: Kapazitaet offener Deliveries, Batch, Idle-Takt
TELEGRAM_DELIVERY_QUEUE_SIZE=500
TELEGRAM_DELIVERY_BATCH_SIZE=10
TELEGRAM_DELIVERY_FLUSH_SECONDS=1
# Lease fuer PROCESSING-Deliveries (abgelaufene Leases werden zurueckgewonnen):
TELEGRAM_DELIVERY_LEASE_SECONDS=60
# Retries: begrenzte Versuche, Exponential Backoff + Jitter, 429 Retry-After
TELEGRAM_MAX_RETRY_ATTEMPTS=5
TELEGRAM_RETRY_MIN_SECONDS=1
TELEGRAM_RETRY_MAX_SECONDS=60
TELEGRAM_RETRY_JITTER_SECONDS=1
# Rate Limits pro Gruppe (konservativ unter Telegram-Limit ~20/min):
TELEGRAM_GROUP_MESSAGES_PER_MINUTE=18
TELEGRAM_GROUP_MIN_INTERVAL_SECONDS=1.5
TELEGRAM_EDIT_MIN_INTERVAL_SECONDS=3
# Identischer Inhalt innerhalb dieses Fensters wird als Duplikat verworfen:
TELEGRAM_DEDUPLICATION_WINDOW_SECONDS=300
TELEGRAM_SYSTEM_ALERTS_ENABLED=true
# Cooldown pro Admin fuer /status, /health und /daily:
TELEGRAM_STATUS_COMMAND_COOLDOWN_SECONDS=15
TELEGRAM_ADMIN_COMMAND_AUDIT_ENABLED=true

# --- Marktuniversum (V1) ------------------------------------------------------
# Symbole, keine Instrument-IDs. IDs werden dynamisch per Discovery aufgeloest.
UNIVERSE_EQUITY_SYMBOLS=AAPL-PERP
UNIVERSE_CRYPTO_SYMBOLS=BTC-PERP
UNIVERSE_REFRESH_ENABLED=true
UNIVERSE_REFRESH_INTERVAL_SECONDS=300
UNIVERSE_REFRESH_JITTER_SECONDS=15

# --- Datenqualitaet -----------------------------------------------------------
# So viele invalide Events pro Instrument im Fenster => DATA_INVALID
DATA_QUALITY_INVALID_EVENT_THRESHOLD=20
DATA_QUALITY_INVALID_EVENT_WINDOW_SECONDS=60
# Max. plausible Abweichung eines Preises vom letzten Mark Price (Basispunkte)
DATA_OUTLIER_MAX_DEVIATION_BPS=500
# Mark-/Index-/Mid-Divergenz oberhalb dieser Schwelle => DEGRADED
DATA_QUALITY_MARK_DIVERGENCE_DEGRADED_BPS=300
