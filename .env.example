# =============================================================================
# polysignal-intelligence – Beispielkonfiguration
# Kopieren nach `.env` (im Repository-Root) und Werte setzen.
# Diese Datei enthaelt KEINE echten Secrets.
# =============================================================================

# --- Applikation --------------------------------------------------------------
APP_ENVIRONMENT=local                # local | staging | production
APP_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
APP_KILL_SWITCH=false                # true = Bot pausiert (keine neuen Signale)
APP_CONFIG_VERSION=v1
APP_STRATEGY_VERSION=v1
APP_DISPLAY_TIMEZONE=Europe/Berlin   # Anzeige-Zeitzone fuer Telegram; Speicherung immer UTC

# --- API (FastAPI) ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- PostgreSQL ---------------------------------------------------------------
# Wird von der App verwendet. Innerhalb von Docker Compose zeigt der Host auf
# den Service `polysignal_postgres`, lokal auf `localhost`.
DATABASE_URL=postgresql+asyncpg://polysignal_user:change-me@localhost:5432/polysignal_intelligence
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# Nur fuer Docker Compose (Initialisierung des Postgres-Containers):
POSTGRES_PASSWORD=change-me

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=polysignal:

# --- Polymarket Perps (nur oeffentliche Marktdaten, read-only) ----------------
POLYMARKET_REST_BASE_URL=https://api.perpetuals.polymarket.com
POLYMARKET_WS_URL=wss://ws.perpetuals.polymarket.com/v1/ws
POLYMARKET_REQUEST_TIMEOUT_SECONDS=10
POLYMARKET_MAX_RETRIES=3
POLYMARKET_BACKOFF_BASE_SECONDS=0.5
POLYMARKET_BACKOFF_MAX_SECONDS=30
# Gewichtetes Token-Budget pro Minute (Polymarket-Limit: 1000/min pro IP;
# konservativ darunter bleiben):
POLYMARKET_RATE_LIMIT_BUDGET_PER_MINUTE=800
POLYMARKET_INSTRUMENT_CACHE_TTL_SECONDS=300
POLYMARKET_KLINES_CACHE_TTL_SECONDS=60

# --- Telegram (einziger externer Output-Kanal) --------------------------------
# Bot-Token vom BotFather; Gruppe, in die Signale gesendet werden.
# In Phase <= 4 optional; fuer den Telegram-Service (Phase 6) erforderlich.
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Nur diese User-IDs duerfen Admin-Kommandos verwenden (Komma-separiert oder JSON):
TELEGRAM_ADMIN_USER_IDS=

# --- Marktuniversum (V1) ------------------------------------------------------
# Symbole, keine Instrument-IDs. IDs werden dynamisch per Discovery aufgeloest.
UNIVERSE_EQUITY_SYMBOLS=AAPL-PERP
UNIVERSE_CRYPTO_SYMBOLS=BTC-PERP
UNIVERSE_REFRESH_ENABLED=true
UNIVERSE_REFRESH_INTERVAL_SECONDS=300
UNIVERSE_REFRESH_JITTER_SECONDS=15

# --- Datenqualitaet -----------------------------------------------------------
# Aelter als Schwelle => DATA_STALE => keine neuen Signale.
DATA_QUALITY_TICKER_STALE_AFTER_SECONDS=30
DATA_QUALITY_ORDERBOOK_STALE_AFTER_SECONDS=30
DATA_QUALITY_CANDLE_STALE_AFTER_SECONDS=180
